# Free keys, no card: https://aistudio.google.com  and  https://console.groq.com
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PROVIDER=gemini        # gemini | groq (the other is automatic 429 fallback if its key is set)
MOCK_LLM=true              # true = deterministic offline mode; set false to use real models
VAULT_KEY=change-me-long-random-string
STREAM_PACE_S=0.35         # slows SSE steps for live demos
ALLOW_DEMO_TAMPER=true
